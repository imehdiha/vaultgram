{
  "name": "vaultgram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted encrypted Telegram vault backed by Cloudflare KV",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/install.mjs",
    "typecheck": "tsc --noEmit",
    "types:bindings": "wrangler types --no-include-runtime",
    "lint": "eslint .",
    "test": "vitest run",
    "test:installer": "node --test tests/installer.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:installer && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply VAULTGRAM_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply VAULTGRAM_DB --remote",
    "setup:webhook": "node scripts/webhook.mjs set",
    "setup:bot-menu": "node scripts/bot-menu.mjs",
    "webhook:status": "node scripts/webhook.mjs status",
    "secrets:generate": "node scripts/secrets.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260726.1",
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
